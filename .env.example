# Local runtime
APP_ENV=development
DATABASE_URL=postgresql+psycopg://patientcapital:patientcapital@db:5432/patientcapital
TEST_DATABASE_URL=postgresql+psycopg://patientcapital:patientcapital@localhost:55432/patientcapital
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
POSTGRES_DB=patientcapital
POSTGRES_USER=patientcapital
POSTGRES_PASSWORD=change-me

# GigaChat is disabled until the documented live quality gate passes.
GIGACHAT_ENABLED=false
GIGACHAT_API_KEY=
GIGACHAT_CLIENT_ID=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_CA_BUNDLE=/app/certs/russian_trusted_root_ca_pem.crt
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_TIMEOUT_SECONDS=30
