# Local runtime
APP_ENV=development
DATABASE_URL=postgresql+psycopg://patientcapital:change-me@localhost:55432/patientcapital
TEST_DATABASE_URL=postgresql+psycopg://patientcapital:change-me@localhost:55432/patientcapital_test
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
POSTGRES_DB=patientcapital
POSTGRES_USER=patientcapital
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=55432

# Automatic discovery uses only the allowlisted delayed MOEX ISS endpoint.
MOEX_ISS_BASE_URL=https://iss.moex.com/iss
MOEX_TIMEOUT_SECONDS=10
MOEX_MAX_AGE_SECONDS=345600
MARKET_RESEARCH_CACHE_SECONDS=14400
MARKET_RESEARCH_STOCK_PREFILTER_LIMIT=12
MONITOR_SCHEDULE=06:00,10:00,14:00,18:00
MONITOR_TIMEZONE=Europe/Moscow

# Receipt images are validated, OCRed locally, and removed from temporary storage immediately.
UPLOAD_MAX_BYTES=8388608
UPLOAD_MAX_PIXELS=20000000
OCR_TIMEOUT_SECONDS=20
UPLOAD_TEMP_DIRECTORY=/tmp

# GigaChat-2 failed the documented live gate; values below are only for a future re-eval.
GIGACHAT_ENABLED=false
GIGACHAT_API_KEY=
GIGACHAT_CLIENT_ID=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_CA_BUNDLE=certs/russian_trusted_root_ca_pem.crt
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_TIMEOUT_SECONDS=30
